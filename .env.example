// Environment variables belong on Render, never in index.html or GitHub.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
SUPER_ADMIN_TELEGRAM_ID=
# Optional: without these two, PostgreSQL stores product image bytes durably.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
# Optional path to a trusted Supabase CA certificate if your host requires it:
# PGSSLROOTCERT=
